{
  "welcomeFile": "/vendor-requests/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/vendor-requests/(.*)$",
      "target": "vendor-requests/$1",
      "localDir": "resources",
      "authenticationType": "ias"
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "authenticationType": "ias",
      "csrfProtection": true
    }
  ]
}
