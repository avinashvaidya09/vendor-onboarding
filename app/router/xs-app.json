{
  "welcomeFile": "/vendor-requests/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/vendor-requests/(.*)$",
      "target": "vendor-requests/$1",
      "localDir": "resources"
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "csrfProtection": true
    }
  ]
}
