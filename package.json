{
  "name": "vendor-onboarding",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-vendor-requests": "cds watch --open vendorrequests/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "[development]": {
      "requires": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": { "password": "alice", "roles": ["VendorRequester"] },
            "bob":   { "password": "bob",   "roles": ["VendorReviewer"]  }
          }
        }
      }
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/vendor-requests"
  ]
}
